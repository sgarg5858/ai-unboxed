{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI, Unboxed chapter",
  "description": "One chapter of the course. Register new files in src/content/course.ts.",
  "type": "object",
  "required": ["id", "name", "slides"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "URL segment, e.g. #/assistant/3"
    },
    "name": {
      "type": "string",
      "description": "Label in the chapter rail"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/slide"
      }
    }
  },
  "definitions": {
    "slide": {
      "type": "object",
      "required": ["title", "body"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "array",
          "description": "Paragraph strings, {\"ul\": [...]} lists, {\"h\": \"...\"} subheadings or {\"note\": \"...\", \"kind\": \"key|analogy|dev|warn|example\"} callouts",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Inline HTML allowed (b, i, code, span class, a href (with target _blank and rel noopener noreferrer), and <mark> around the few points that are critical to understand). Inline style attributes are stripped."
              },
              {
                "type": "object",
                "required": ["ul"],
                "additionalProperties": false,
                "properties": {
                  "ul": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Inline HTML allowed (b, i, code, span class, a href (with target _blank and rel noopener noreferrer), and <mark> around the few points that are critical to understand). Inline style attributes are stripped."
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["h"],
                "additionalProperties": false,
                "properties": {
                  "h": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": ["note", "kind"],
                "additionalProperties": false,
                "properties": {
                  "note": {
                    "type": "string",
                    "description": "Inline HTML allowed (b, i, code, span class, a href (with target _blank and rel noopener noreferrer), and <mark> around the few points that are critical to understand). Inline style attributes are stripped."
                  },
                  "kind": {
                    "enum": ["key", "analogy", "dev", "warn", "example"]
                  }
                }
              }
            ]
          }
        },
        "code": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Code sample under the prose, one string per line"
        },
        "viz": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/block"
          },
          "description": "Right-hand column, rendered top to bottom"
        },
        "summary": {
          "type": "string",
          "description": "One-sentence takeaway shown under the title. Inline HTML allowed."
        },
        "figure": {
          "type": "object",
          "description": "A wide image shown under both columns. Paths are relative to public/, e.g. images/x.svg.",
          "required": ["src", "alt", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^[^/].*"
            },
            "darkSrc": {
              "type": "string",
              "pattern": "^[^/].*"
            },
            "alt": {
              "type": "string",
              "minLength": 20
            },
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            },
            "caption": {
              "type": "string",
              "description": "Inline HTML allowed (b, i, code, span class, a href (with target _blank and rel noopener noreferrer), and <mark> around the few points that are critical to understand)."
            }
          }
        }
      }
    },
    "goto": {
      "type": "object",
      "required": ["chapter"],
      "additionalProperties": false,
      "properties": {
        "chapter": {
          "type": "string"
        },
        "slide": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stageItem": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Inline HTML allowed (b, i, code, span class, a href (with target _blank and rel noopener noreferrer), and <mark> around the few points that are critical to understand). Inline style attributes are stripped."
        },
        "sub": {
          "type": "string",
          "description": "Inline HTML allowed (b, i, code, span class, a href (with target _blank and rel noopener noreferrer), and <mark> around the few points that are critical to understand). Inline style attributes are stripped."
        },
        "value": {
          "type": "string"
        },
        "tone": {
          "enum": ["pos", "neg", "muted", "accent", "heat"]
        },
        "highlight": {
          "type": "boolean"
        },
        "dim": {
          "type": "boolean"
        },
        "strike": {
          "type": "boolean"
        },
        "mono": {
          "type": "boolean"
        },
        "spacer": {
          "type": "boolean"
        },
        "goto": {
          "$ref": "#/definitions/goto"
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "caption",
            "stages",
            "chips",
            "bars",
            "table",
            "stat",
            "code",
            "shape",
            "panel",
            "tabs",
            "stepper",
            "widget",
            "embed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "caption"
              }
            }
          },
          "then": {
            "required": ["html"],
            "properties": {
              "type": {
                "const": "caption"
              },
              "html": {
                "type": "string",
                "description": "Inline HTML allowed (b, i, code, span class, a href (with target _blank and rel noopener noreferrer), and <mark> around the few points that are critical to understand). Inline style attributes are stripped."
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stages"
              }
            }
          },
          "then": {
            "required": ["items"],
            "properties": {
              "type": {
                "const": "stages"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/stageItem"
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chips"
              }
            }
          },
          "then": {
            "required": ["items"],
            "properties": {
              "type": {
                "const": "chips"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text"],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "sub": {
                      "type": "string"
                    },
                    "hot": {
                      "type": "boolean"
                    },
                    "dim": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bars"
              }
            }
          },
          "then": {
            "required": ["items"],
            "properties": {
              "type": {
                "const": "bars"
              },
              "layout": {
                "enum": ["inline", "stacked"]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "display": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": ["rows"],
            "properties": {
              "type": {
                "const": "table"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["head", "cells"],
                  "additionalProperties": false,
                  "properties": {
                    "head": {
                      "type": "string"
                    },
                    "cells": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["text"],
                        "additionalProperties": false,
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "tone": {
                            "enum": ["accent", "heat"]
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stat"
              }
            }
          },
          "then": {
            "required": ["items"],
            "properties": {
              "type": {
                "const": "stat"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            }
          },
          "then": {
            "required": ["source"],
            "properties": {
              "type": {
                "const": "code"
              },
              "source": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "title": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shape"
              }
            }
          },
          "then": {
            "required": ["text"],
            "properties": {
              "type": {
                "const": "shape"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "panel"
              }
            }
          },
          "then": {
            "required": ["blocks"],
            "properties": {
              "type": {
                "const": "panel"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/block"
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tabs"
              }
            }
          },
          "then": {
            "required": ["tabs"],
            "properties": {
              "type": {
                "const": "tabs"
              },
              "selected": {
                "type": "integer",
                "minimum": 0
              },
              "tabs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["label", "blocks"],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "blocks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/block"
                      }
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stepper"
              }
            }
          },
          "then": {
            "required": ["steps"],
            "properties": {
              "type": {
                "const": "stepper"
              },
              "accumulate": {
                "type": "boolean"
              },
              "nextLabel": {
                "type": "string"
              },
              "restartLabel": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "item": {
                      "$ref": "#/definitions/stageItem"
                    },
                    "blocks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/block"
                      }
                    },
                    "caption": {
                      "type": "string",
                      "description": "Inline HTML allowed (b, i, code, span class, a href (with target _blank and rel noopener noreferrer), and <mark> around the few points that are critical to understand). Inline style attributes are stripped."
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "widget"
              }
            }
          },
          "then": {
            "required": ["name"],
            "properties": {
              "type": {
                "const": "widget"
              },
              "name": {
                "enum": [
                  "fruit-similarity",
                  "tokenizer",
                  "utf8-bytes",
                  "token-cost",
                  "letter-count",
                  "context-fit",
                  "embedding-table",
                  "embedding-geometry",
                  "positional-heatmap",
                  "rope",
                  "residual-matrix",
                  "attention-arcs",
                  "qkv-matrices",
                  "score-matrix",
                  "causal-mask",
                  "attention-weights",
                  "attention-heads",
                  "attention-cost",
                  "residual-stream",
                  "rms-norm",
                  "activations",
                  "param-counter",
                  "moe-router",
                  "temperature",
                  "sampling",
                  "kv-cache",
                  "cross-entropy",
                  "gradient-descent",
                  "loss-curve",
                  "prompt-assembly",
                  "classifier-threshold",
                  "injection-defenses",
                  "assistant-architecture",
                  "thinking-budget",
                  "singleton-rate",
                  "guess-or-abstain"
                ],
                "description": "Key in src/app/widgets/registry.ts"
              },
              "props": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "embed"
              }
            }
          },
          "then": {
            "required": ["src", "title"],
            "properties": {
              "type": {
                "const": "embed"
              },
              "src": {
                "type": "string",
                "pattern": "^https://",
                "description": "External tool URL. Loaded in a sandboxed iframe only when the reader clicks."
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "height": {
                "type": "integer",
                "minimum": 300,
                "maximum": 1200
              }
            },
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
