            {
              "label": "<b>Vocabulary</b>",
              "sub": "The fixed list of every token the model knows, each with a number as its ID.",
              "value": "~100k tokens"
            },
            {
              "label": "<b>Vector / tensor</b>",
              "sub": "A list of numbers / a block of numbers with several dimensions.",
              "value": "[B, n, d]"
            },
            {
              "label": "<b>Embedding</b>",
              "sub": "The vector that represents one token inside the model.",
              "value": "d numbers"
            },
            {
              "label": "<b>Parameter (weight)</b>",
              "sub": "One learned number inside the model. Model sizes count these.",
              "value": "7B, 70B…"
            },
            {
              "label": "<b>Layer (block)</b>",
              "sub": "One repeated unit of the model: attention, then an MLP (a small neural network).",
              "value": "× N"
            },
            {
              "label": "<b>Forward pass</b>",
              "sub": "One run of the model, from token IDs in to scores out.",
              "value": "1 per token"
            },
